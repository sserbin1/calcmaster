// CalcMaster Programmatic SEO Template
// Generates unique landing pages from calculator data

import { Metadata } from 'next';
import { notFound } from 'next/navigation';
import { calculatorData, CalculatorConfig } from '@/lib/calculator-data';

// ============================================
// TYPES
// ============================================

interface CalculatorPageData {
  slug: string;
  name: string;
  category: 'health' | 'finance' | 'math' | 'date-time' | 'construction' | 'fun' | 'education';
  primaryKeyword: string;
  secondaryKeywords: string[];
  heroTitle: string;
  heroSubtitle: string;
  metaTitle: string;
  metaDescription: string;
  introText: string;
  howItWorks: { step: number; title: string; description: string }[];
  benefits: { title: string; description: string; icon: string }[];
  educationalContent: {
    title: string;
    paragraphs: string[];
    tables?: { headers: string[]; rows: string[][] }[];
  };
  faqs: { question: string; answer: string }[];
  relatedCalculators: string[];
  longTailVariants: { slug: string; title: string; keyword: string }[];
  formula?: string;
  lastUpdated: string;
}

// ============================================
// METADATA GENERATOR (Dynamic SEO)
// ============================================

export async function generateMetadata({
  params
}: {
  params: { category: string; slug: string }
}): Promise<Metadata> {
  const calculator = await getCalculatorData(params.category, params.slug);

  if (!calculator) return {};

  return {
    title: calculator.metaTitle,
    description: calculator.metaDescription,
    keywords: [calculator.primaryKeyword, ...calculator.secondaryKeywords],
    alternates: {
      canonical: `https://calcmaster.io/${params.category}/${params.slug}/`,
    },
    openGraph: {
      title: calculator.metaTitle,
      description: calculator.metaDescription,
      url: `https://calcmaster.io/${params.category}/${params.slug}/`,
      siteName: 'CalcMaster',
      images: [{
        url: `/og-images/${params.slug}.png`,
        width: 1200,
        height: 630,
        alt: `${calculator.name} Calculator`,
      }],
      locale: 'en_US',
      type: 'website',
    },
    twitter: {
      card: 'summary_large_image',
      title: calculator.metaTitle,
      description: calculator.metaDescription,
    },
    robots: {
      index: true,
      follow: true,
      googleBot: {
        index: true,
        follow: true,
        'max-video-preview': -1,
        'max-image-preview': 'large',
        'max-snippet': -1,
      },
    },
  };
}

// ============================================
// STATIC PARAMS GENERATOR (All Calculator Pages)
// ============================================

export async function generateStaticParams() {
  // Generate params for all 60 calculators
  const calculators = await getAllCalculators();

  return calculators.map((calc) => ({
    category: calc.category,
    slug: calc.slug,
  }));
}

// ============================================
// PAGE COMPONENT TEMPLATE
// ============================================

export default async function CalculatorPage({
  params
}: {
  params: { category: string; slug: string }
}) {
  const calculator = await getCalculatorData(params.category, params.slug);

  if (!calculator) {
    notFound();
  }

  return (
    <>
      {/* JSON-LD Structured Data */}
      <script
        type="application/ld+json"
        dangerouslySetInnerHTML={{
          __html: JSON.stringify(generateStructuredData(calculator, params)),
        }}
      />

      {/* Hero Section */}
      <section className="hero">
        <h1>{calculator.heroTitle}</h1>
        <p className="subtitle">{calculator.heroSubtitle}</p>
      </section>

      {/* Calculator Component (Dynamic Import) */}
      <section className="calculator-section">
        <CalculatorComponent type={params.slug} />
      </section>

      {/* AI Explanation */}
      <section className="ai-explanation">
        <AIExplanation calculatorType={params.slug} />
      </section>

      {/* Intro Text (Unique per calculator) */}
      <section className="intro">
        <p>{calculator.introText}</p>
      </section>

      {/* How It Works */}
      <section className="how-it-works">
        <h2>How to Use the {calculator.name} Calculator</h2>
        <ol>
          {calculator.howItWorks.map((step) => (
            <li key={step.step}>
              <h3>Step {step.step}: {step.title}</h3>
              <p>{step.description}</p>
            </li>
          ))}
        </ol>
      </section>

      {/* Benefits */}
      <section className="benefits">
        <h2>Why Use CalcMaster's {calculator.name} Calculator?</h2>
        <ul className="benefits-grid">
          {calculator.benefits.map((benefit, i) => (
            <li key={i}>
              <span className="icon">{benefit.icon}</span>
              <h3>{benefit.title}</h3>
              <p>{benefit.description}</p>
            </li>
          ))}
        </ul>
      </section>

      {/* Educational Content (Unique, 300+ words) */}
      <article className="educational-content">
        <h2>{calculator.educationalContent.title}</h2>
        {calculator.educationalContent.paragraphs.map((para, i) => (
          <p key={i}>{para}</p>
        ))}
        {calculator.educationalContent.tables?.map((table, i) => (
          <table key={i}>
            <thead>
              <tr>
                {table.headers.map((h, j) => <th key={j}>{h}</th>)}
              </tr>
            </thead>
            <tbody>
              {table.rows.map((row, j) => (
                <tr key={j}>
                  {row.map((cell, k) => <td key={k}>{cell}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        ))}
      </article>

      {/* FAQ Section with Schema */}
      <section className="faq">
        <h2>Frequently Asked Questions</h2>
        {calculator.faqs.map((faq, i) => (
          <details key={i}>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </section>

      {/* Related Calculators (Internal Links) */}
      <section className="related">
        <h2>Related Calculators</h2>
        <ul>
          {calculator.relatedCalculators.map((related) => (
            <li key={related}>
              <a href={`/${getCategoryForCalculator(related)}/${related}/`}>
                {formatCalculatorName(related)} Calculator
              </a>
            </li>
          ))}
        </ul>
      </section>

      {/* Long-tail Variants (More Internal Links) */}
      {calculator.longTailVariants.length > 0 && (
        <section className="variants">
          <h2>More {calculator.name} Calculators</h2>
          <ul>
            {calculator.longTailVariants.map((variant) => (
              <li key={variant.slug}>
                <a href={`/${params.category}/${params.slug}/${variant.slug}/`}>
                  {variant.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {/* Last Updated (Freshness Signal) */}
      <footer className="page-footer">
        <p>Last updated: {calculator.lastUpdated}</p>
      </footer>
    </>
  );
}

// ============================================
// STRUCTURED DATA GENERATOR
// ============================================

function generateStructuredData(
  calculator: CalculatorPageData,
  params: { category: string; slug: string }
) {
  return [
    // WebApplication Schema
    {
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      'name': `${calculator.name} Calculator`,
      'url': `https://calcmaster.io/${params.category}/${params.slug}/`,
      'description': calculator.metaDescription,
      'applicationCategory': getSchemaCategory(params.category),
      'operatingSystem': 'Any',
      'offers': {
        '@type': 'Offer',
        'price': '0',
        'priceCurrency': 'USD',
      },
      'author': {
        '@type': 'Organization',
        'name': 'CalcMaster',
        'url': 'https://calcmaster.io',
      },
    },
    // FAQPage Schema
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      'mainEntity': calculator.faqs.map((faq) => ({
        '@type': 'Question',
        'name': faq.question,
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': faq.answer,
        },
      })),
    },
    // BreadcrumbList Schema
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      'itemListElement': [
        {
          '@type': 'ListItem',
          'position': 1,
          'name': 'Home',
          'item': 'https://calcmaster.io/',
        },
        {
          '@type': 'ListItem',
          'position': 2,
          'name': formatCategoryName(params.category),
          'item': `https://calcmaster.io/${params.category}/`,
        },
        {
          '@type': 'ListItem',
          'position': 3,
          'name': `${calculator.name} Calculator`,
          'item': `https://calcmaster.io/${params.category}/${params.slug}/`,
        },
      ],
    },
  ];
}

// ============================================
// HELPER FUNCTIONS
// ============================================

function getSchemaCategory(category: string): string {
  const mapping: Record<string, string> = {
    'health': 'HealthApplication',
    'finance': 'FinanceApplication',
    'math': 'UtilityApplication',
    'date-time': 'UtilityApplication',
    'construction': 'UtilityApplication',
    'fun': 'GameApplication',
    'education': 'EducationalApplication',
  };
  return mapping[category] || 'UtilityApplication';
}

function formatCategoryName(category: string): string {
  const mapping: Record<string, string> = {
    'health': 'Health & Fitness',
    'finance': 'Financial',
    'math': 'Math',
    'date-time': 'Date & Time',
    'construction': 'Construction',
    'fun': 'Fun & Games',
    'education': 'Education',
  };
  return mapping[category] || category;
}

function formatCalculatorName(slug: string): string {
  return slug
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

// ============================================
// DATA FETCHING (Replace with your data source)
// ============================================

async function getCalculatorData(
  category: string,
  slug: string
): Promise<CalculatorPageData | null> {
  // In production: fetch from CMS, database, or JSON files
  return calculatorData[`${category}/${slug}`] || null;
}

async function getAllCalculators(): Promise<{ category: string; slug: string }[]> {
  // Return all calculator paths for static generation
  return Object.keys(calculatorData).map((key) => {
    const [category, slug] = key.split('/');
    return { category, slug };
  });
}

function getCategoryForCalculator(slug: string): string {
  // Lookup category for a calculator slug
  const entry = Object.entries(calculatorData).find(
    ([key]) => key.endsWith(`/${slug}`)
  );
  return entry ? entry[0].split('/')[0] : 'tools';
}
